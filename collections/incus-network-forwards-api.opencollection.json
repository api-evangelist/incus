{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incus external REST certificates network-forwards API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "network-forwards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the network address forwards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/1.0/networks/:networkName/forwards",
            "params": [
              {
                "name": "networkName",
                "value": "",
                "type": "path",
                "description": "Network name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              },
              {
                "name": "filter",
                "value": "default",
                "type": "query",
                "description": "Collection filter"
              }
            ]
          },
          "docs": "Returns a list of network address forwards (URLs)."
        },
        {
          "info": {
            "name": "Add a network address forward",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/1.0/networks/:networkName/forwards",
            "params": [
              {
                "name": "networkName",
                "value": "",
                "type": "path",
                "description": "Network name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
