{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incus external REST certificates profiles API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/1.0/profiles",
            "params": [
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              },
              {
                "name": "all-projects",
                "value": "true",
                "type": "query",
                "description": "Retrieve profiles from all projects"
              },
              {
                "name": "filter",
                "value": "default",
                "type": "query",
                "description": "Collection filter"
              }
            ]
          },
          "docs": "Returns a list of profiles (URLs)."
        },
        {
          "info": {
            "name": "Add a profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/1.0/profiles",
            "params": [
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Creates a new profile."
        },
        {
          "info": {
            "name": "Get the profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/1.0/profiles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Profile name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Gets a specific profile."
        },
        {
          "info": {
            "name": "Rename the profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/1.0/profiles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Profile name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Renames an existing profile."
        },
        {
          "info": {
            "name": "Update the profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/1.0/profiles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Profile name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Updates the entire profile configuration."
        },
        {
          "info": {
            "name": "Partially update the profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/1.0/profiles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Profile name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Updates a subset of the profile configuration."
        },
        {
          "info": {
            "name": "Delete the profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/1.0/profiles/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Profile name"
              },
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              }
            ]
          },
          "docs": "Removes the profile."
        },
        {
          "info": {
            "name": "Get the profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/1.0/profiles?recursion=1",
            "params": [
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              },
              {
                "name": "all-projects",
                "value": "true",
                "type": "query",
                "description": "Retrieve profiles from all projects"
              },
              {
                "name": "filter",
                "value": "default",
                "type": "query",
                "description": "Collection filter"
              }
            ]
          },
          "docs": "Returns a list of profiles (structs)."
        }
      ]
    }
  ],
  "bundled": true
}