{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incus external REST certificates metrics API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/1.0/metrics",
            "params": [
              {
                "name": "project",
                "value": "default",
                "type": "query",
                "description": "Project name"
              },
              {
                "name": "target",
                "value": "server01",
                "type": "query",
                "description": "Cluster member name"
              }
            ]
          },
          "docs": "Gets metrics of instances."
        }
      ]
    }
  ],
  "bundled": true
}